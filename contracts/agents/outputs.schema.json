{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:close-out-demo:contracts:agent-outputs",
  "title": "AgentOutput",
  "description": "Proposed agent outputs are recommendations/manifests, never approval or execution authority.",
  "anyOf": [{ "$ref": "#/$defs/GapAnalysis" }, { "$ref": "#/$defs/PackageManifest" }],
  "$defs": {
    "Gap": {
      "title": "Gap", "type": "object",
      "required": ["conditionType", "conditionId", "reason", "evidenceRefs"],
      "properties": {
        "conditionType": { "type": "string", "enum": ["ChecklistItem", "ArtifactRequirement", "Ticket", "WorkOrder"] },
        "conditionId": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:close-out-demo:contracts:models#/$defs/EvidenceRef" } }
      }, "additionalProperties": true
    },
    "ReworkProposal": {
      "title": "ReworkProposal", "type": "object",
      "required": ["reason", "validationResultIds", "ticketIds"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "subcontractorId": { "type": "string", "minLength": 1 },
        "validationResultIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "ticketIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }, "additionalProperties": true
    },
    "GapAnalysis": {
      "title": "GapAnalysis", "type": "object",
      "required": ["caseId", "siteId", "generatedAt", "model", "modelVersion", "gaps", "proposedRework"],
      "properties": {
        "caseId": { "type": "string", "format": "uuid" },
        "siteId": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/Gap" } },
        "proposedRework": { "anyOf": [{ "$ref": "#/$defs/ReworkProposal" }, { "type": "null" }] }
      }, "additionalProperties": true
    },
    "PackageFile": {
      "title": "PackageFile", "type": "object",
      "required": ["format", "blobUrl"],
      "properties": {
        "format": { "type": "string", "enum": ["docx", "pdf"] },
        "blobUrl": { "type": "string", "format": "uri" }
      }, "additionalProperties": true
    },
    "PackageManifest": {
      "title": "PackageManifest", "type": "object",
      "description": "Manifest must be checked against current accepted evidence before PackageReady. File conversion and Dataverse storage are not yet agreed.",
      "required": ["artifactId", "caseId", "siteId", "createdAt", "model", "modelVersion", "evidenceRefs", "files"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "caseId": { "type": "string", "format": "uuid" },
        "siteId": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "urn:close-out-demo:contracts:models#/$defs/EvidenceRef" } },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PackageFile" } }
      }, "additionalProperties": true
    }
  }
}
