{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:close-out-demo:contracts:evidence-batch",
  "title": "EvidenceBatch",
  "description": "Isolated synthetic test registration, not a Dataverse upload or an approval. Register before uploading; pin each immutable input with its SHA256 and If-Match ETag.",
  "type": "object",
  "required": ["schemaVersion", "runId", "batchId", "caseId", "siteId", "program", "registeredAt", "facts", "members"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "runId": { "type": "string", "format": "uuid" },
    "batchId": { "type": "string", "format": "uuid" },
    "caseId": { "type": "string", "format": "uuid" },
    "siteId": { "type": "string", "minLength": 1 },
    "program": { "type": "string", "minLength": 1 },
    "registeredAt": { "type": "string", "format": "date-time" },
    "facts": {
      "description": "Explicit synthetic baseline used for validation context, never a substitute for the coordinator's native Fabric tool. Seeded validations are not uploaded-inference results.",
      "type": "object"
    },
    "members": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/BatchEvidence" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "PinnedBlob": {
      "title": "PinnedBlob",
      "type": "object",
      "required": ["url", "etag", "sha256", "mediaType"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://[a-z0-9]+\\.blob\\.core\\.windows\\.net/[^?#]+$" },
        "etag": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "versionId": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "enum": ["image/png", "application/pdf", "text/plain"] }
      },
      "additionalProperties": false
    },
    "BatchEvidence": {
      "title": "BatchEvidence",
      "type": "object",
      "required": ["evidenceId", "kind", "metadata", "blob"],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["photo", "document"] },
        "metadata": { "type": "object" },
        "blob": { "$ref": "#/$defs/PinnedBlob" },
        "text": {
          "description": "Optional pinned synthetic text counterpart. It does not imply PDF OCR or document IQ ingestion.",
          "$ref": "#/$defs/PinnedBlob"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "photo" } } },
          "then": {
            "properties": {
              "metadata": { "$ref": "urn:close-out-demo:contracts:models#/$defs/Photo" },
              "blob": { "type": "object", "properties": { "mediaType": { "const": "image/png" } } }
            }
          },
          "else": {
            "properties": {
              "metadata": { "$ref": "urn:close-out-demo:contracts:models#/$defs/AcceptanceArtifact" },
              "blob": { "type": "object", "properties": { "mediaType": { "const": "application/pdf" } } }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
